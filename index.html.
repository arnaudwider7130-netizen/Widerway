
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="WiderWay, plateforme gratuite d'éducation et de recherche scientifique pour l'Afrique et le monde.">
<title>WiderWay | Le savoir ouvre toutes les voies</title>

<style>
:root {
  --primary:#075c46;
  --secondary:#0b8060;
  --light:#eaf5f0;
  --dark:#172b25;
  --muted:#687b73;
  --white:#ffffff;
  --bg:#f5f8f6;
  --border:#dce8e1;
}
* {box-sizing:border-box}
body {
  margin:0;
  font-family:Arial, sans-serif;
  background:var(--bg);
  color:var(--dark);
  line-height:1.6;
}
header {
  background:var(--primary);
  color:white;
  padding:18px 5%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  flex-wrap:wrap;
  gap:15px;
}
.logo {font-size:27px;font-weight:bold}
.logo span {color:#a9e5c9}
nav {display:flex;gap:8px;flex-wrap:wrap}
nav button {
  background:transparent;
  color:white;
  border:1px solid #ffffff55;
  padding:9px 13px;
  border-radius:7px;
  cursor:pointer;
}
nav button:hover {background:#ffffff22}
main {max-width:1150px;margin:auto;padding:25px 5%;min-height:65vh}
.hero {
  background:linear-gradient(135deg,#075c46,#0b8060);
  color:white;
  padding:55px 25px;
  border-radius:15px;
  text-align:center;
}
.hero h1 {font-size:36px;margin:0 0 12px}
.hero p {font-size:17px;max-width:650px;margin:10px auto}
.btn {
  background:#ffffff;
  color:var(--primary);
  border:0;
  padding:12px 20px;
  border-radius:7px;
  font-weight:bold;
  cursor:pointer;
  margin-top:15px;
}
.section-title {color:var(--primary);margin-top:35px}
.grid {
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(210px,1fr));
  gap:15px;
  margin-top:20px;
}
.card {
  background:white;
  border:1px solid var(--border);
  padding:20px;
  border-radius:11px;
  cursor:pointer;
  transition:.2s;
}
.card:hover {
  border-color:var(--secondary);
  transform:translateY(-3px);
  box-shadow:0 5px 15px #0000000d;
}
.card h3 {color:var(--primary);margin-top:0}
.card p {color:var(--muted);font-size:14px}
.card button {
  background:var(--primary);
  color:white;
  border:0;
  padding:9px 13px;
  border-radius:6px;
  cursor:pointer;
}
.breadcrumb {
  color:var(--muted);
  font-size:14px;
  margin-bottom:20px;
}
.panel {
  background:white;
  border:1px solid var(--border);
  border-radius:12px;
  padding:22px;
  margin-top:20px;
}
input, textarea {
  width:100%;
  padding:13px;
  border:1px solid var(--border);
  border-radius:7px;
  font-size:15px;
  margin:8px 0 15px;
}
.action {
  background:var(--primary);
  color:white;
  padding:10px 15px;
  border:0;
  border-radius:7px;
  cursor:pointer;
}
.secondary {
  background:var(--light);
  color:var(--primary);
}
.resource {
  background:white;
  padding:16px;
  border:1px solid var(--border);
  border-radius:8px;
  margin:10px 0;
}
footer {
  background:#123b30;
  color:white;
  padding:30px 5%;
  text-align:center;
  margin-top:40px;
}
footer p {margin:5px}
.small {font-size:13px;color:var(--muted)}
footer .small {color:#c4d8cf}
@media(max-width:600px) {
  .hero h1 {font-size:27px}
  header {justify-content:center;text-align:center}
  nav {justify-content:center}
}
</style>
</head>

