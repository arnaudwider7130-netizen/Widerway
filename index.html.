/* =====================================
   2. VARIABLES DE NAVIGATION
===================================== */

let selectedCountry = "Burkina Faso";
let selectedUniversity = "Université Joseph Ki-Zerbo";
let selectedField = "";
let selectedLevel = "";
let selectedPath = "";
let selectedSemester = "";
let selectedSubject = "";

const app = document.getElementById("app");

/* =====================================
   3. OUTILS D'AFFICHAGE
===================================== */

function escapeHTML(value) {
  return String(value).replace(/[&<>"']/g, char => ({
    "&":"&amp;",
    "<":"&lt;",
    ">":"&gt;",
    '"':"&quot;",
    "'":"&#39;"
  })[char]);
}

function show(title, html, breadcrumb="WiderWay") {
  app.innerHTML = `
    <div class="breadcrumb">${escapeHTML(breadcrumb)}</div>
    <h2 class="section-title">${escapeHTML(title)}</h2>
    ${html}
  `;
  window.scrollTo({top:0,behavior:"smooth"});
}

function makeCard(title, description, action, value) {
  return `
    <div class="card"
      data-action="${action}"
      data-value="${escapeHTML(value)}">
      <h3>${escapeHTML(title)}</h3>
      <p>${escapeHTML(description)}</p>
      <button type="button">Consulter</button>
    </div>
  `;
}

/* =====================================
   4. PAGE D'ACCUEIL
===================================== */

function home() {
  app.innerHTML = `
    <section class="hero">
      <h1>Bienvenue sur WiderWay</h1>
      <p><strong>Le savoir ouvre toutes les voies.</strong></p>
      <p>Une plateforme gratuite dédiée à l'éducation,
      à la formation et à la recherche scientifique
      en Afrique et dans le monde.</p>
      <button class="btn" data-action="formations">
        Explorer les formations
      </button>
    </section>

    <h2 class="section-title">Nos espaces</h2>
    <div class="grid">
      ${makeCard("Formations","Découvrir les filières et les matières.","formations","")}
      ${makeCard("Bibliothèque","Retrouver les ressources pédagogiques.","library","")}
      ${makeCard("Recherche scientifique","Découvrir l'espace de recherche.","research","")}
      ${makeCard("Communauté","Un espace pour les étudiants et chercheurs.","community","")}
    </div>
  `;
}

/* =====================================
   5. FORMATIONS
===================================== */

function formations() {
  const html = `
    <div class="grid">
      ${makeCard("Burkina Faso","Explorer les formations disponibles au Burkina Faso.","country","Burkina Faso")}
      ${makeCard("Autres pays africains","Espace destiné aux futures universités africaines.","coming","Afrique")}
      ${makeCard("International","Espace destiné aux formations internationales.","coming","International")}
    </div>
  `;
  show("Explorer les formations",html);
}

function country(value) {
  selectedCountry = value;
  const universities = database[value];

  if (!universities) {
    show("Bientôt disponible","<p>Les formations de cette région seront ajoutées progressivement.</p>");
    return;
  }

  let html = '<div class="grid">';
  Object.keys(universities).forEach(university => {
    html += makeCard(university,"Consulter les filières disponibles.","university",university);
  });
  html += '</div>';

  show(value,html,"Formations → "+value);
}

function university(value) {
  selectedUniversity = value;
  const fields = database[selectedCountry][value];

  let html = '<div class="grid">';
  Object.keys(fields).forEach(field => {
    html += makeCard(field,"Explorer les niveaux et les matières.","field",field);
  });
  html += '</div>';

  show(value,html,selectedCountry+" → "+value);
}

/* =====================================
   6. FILIÈRES ET NIVEAUX
===================================== */

function field(value) {
  selectedField = value;
  const data = database[selectedCountry][selectedUniversity][value];

  let html = '<div class="grid">';
  Object.keys(data).forEach(level => {
    html += makeCard(level,"Consulter les semestres de ce niveau.","level",level);
  });
  html += '</div>';

  show(value,html,selectedUniversity+" → "+value);
}

function level(value) {
  selectedLevel = value;
  selectedPath = "";

  const data =
    database[selectedCountry][selectedUniversity][selectedField][value];

  let html = '<div class="grid">';

  Object.keys(data).forEach(item => {
    if (value === "L3") {
      html += makeCard(item,"Consulter les semestres de ce parcours.","path",item);
    } else {
      html += makeCard(item,"Voir les matières de ce semestre.","semester",item);
    }
  });

  html += '</div>';

  show(value,html,selectedField+" → "+value);
}

/* =====================================
   7. PARCOURS DE L3
===================================== */

function path(value) {
  selectedPath = value;

  const data =
    database[selectedCountry][selectedUniversity]
    [selectedField][selectedLevel][selectedPath];

  let html = '<div class="grid">';

  Object.keys(data).forEach(semester => {
    html += makeCard(semester,"Voir les matières du semestre.","semester",semester);
  });

  html += '</div>';

  show(value,html,selectedField+" → L3 → "+value);
}

/* =====================================
   8. MATIÈRES
===================================== */

function semester(value) {
  selectedSemester = value;

  const levelData =
    database[selectedCountry][selectedUniversity]
    [selectedField][selectedLevel];

  const data = selectedLevel === "L3"
    ? levelData[selectedPath][value]
    : levelData[value];

  let html = '<div class="grid">';

  data.forEach(subject => {
    html += makeCard(subject,"Accéder aux ressources de cette matière.","subject",subject);
  });

  html += '</div>';

  show(value,html,selectedField+" → "+selectedLevel+" → "+value);
}

function subject(value) {
  selectedSubject = value;

  const html = `
    <div class="panel">
      <h3>${escapeHTML(value)}</h3>
      <p>Bienvenue dans l'espace consacré à cette matière.</p>
      <p class="small">Les ressources seront ajoutées progressivement.</p>
    </div>

    <div class="grid">
      ${makeCard("Cours","Leçons et supports pédagogiques.","resource","Cours")}
      ${makeCard("Résumés","Fiches de révision et synthèses.","resource","Résumés")}
      ${makeCard("Exercices corrigés","Travaux pratiques et exercices.","resource","Exercices corrigés")}
      ${makeCard("Documents PDF","Documents téléchargeables.","resource","Documents PDF")}
    </div>
  `;

  show(value,html,selectedField+" → "+selectedLevel+" → "+selectedSemester);
}

/* =====================================
   9. RESSOURCES PÉDAGOGIQUES
===================================== */

function resource(value) {
  const html = `
    <div class="panel">
      <h3>${escapeHTML(value)}</h3>
      <p>Matière : <strong>${escapeHTML(selectedSubject)}</strong></p>
      <p>Les ressources de cette rubrique seront publiées
      au fur et à mesure de leur préparation.</p>
      <p class="small">Aucun document n'est encore disponible ici.</p>
    </div>
  `;

  show(value,html,selectedSubject+" → "+value);
}

/* =====================================
   10. BIBLIOTHÈQUE ET RECHERCHE
===================================== */

function allSubjects() {
  let results = [];

  function collect(obj) {
    Object.values(obj).forEach(value => {
      if (Array.isArray(value)) {
        results = results.concat(value);
      } else if (value && typeof value === "object") {
        collect(value);
      }
    });
  }

  collect(database);
  return [...new Set(results)];
}

function library() {
  show("Bibliothèque universitaire",`
    <div class="panel">
      <p>Rechercher une matière dans le catalogue WiderWay.</p>
      <input id="searchInput" placeholder="Exemple : Biologie cellulaire">
      <button class="action" data-action="search">Rechercher</button>
    </div>
    <div id="searchResults"></div>
  `);
}

function search() {
  const input = document.getElementById("searchInput");
  const results = document.getElementById("searchResults");

  if (!input || !results) return;

  const query = input.value.toLowerCase().trim();

  if (!query) {
    results.innerHTML = "<p>Entre le nom d'une matière.</p>";
    return;
  }

  const matches = allSubjects().filter(subject =>
    subject.toLowerCase().includes(query)
  );

  if (!matches.length) {
    results.innerHTML = "<p>Aucune matière trouvée.</p>";
    return;
  }

  results.innerHTML = matches.map(subject => `
    <div class="resource">
      <strong>${escapeHTML(subject)}</strong>
    </div>
  `).join("");
}

function research() {
  show("Recherche scientifique",`
    <div class="panel">
      <h3>Un espace pour la recherche</h3>
      <p>WiderWay ambitionne de faciliter l'accès aux connaissances
      scientifiques, aux travaux universitaires et aux publications.</p>
      <p>Les fonctionnalités de dépôt et de consultation des publications
      seront développées dans une prochaine étape.</p>
    </div>
  `);
}

/* =====================================
   11. COMMUNAUTÉ, À PROPOS, CONTACT
===================================== */

function community() {
  show("Communauté WiderWay",`
    <div class="panel">
      <h3>Apprendre et partager</h3>
      <p>Un espace destiné aux étudiants, enseignants et chercheurs
      pour partager leurs connaissances et leurs expériences.</p>
      <p>Les fonctions de compte utilisateur et de discussion
      seront développées ultérieurement.</p>
    </div>
  `);
}

function about() {
  show("À propos de WiderWay",`
    <div class="panel">
      <h3>Notre vision</h3>
      <p>WiderWay est une initiative éducative et scientifique
      qui vise à rendre le savoir plus accessible.</p>
      <p>Notre ambition est de contribuer au développement
      de l'éducation et de la recherche en Afrique et à l'international.</p>
      <h3>Notre engagement</h3>
      <p>Gratuité, partage des connaissances, collaboration
      et ouverture scientifique.</p>
    </div>
  `);
}

function contact() {
  show("Contact",`
    <div class="panel">
      <h3>Nous contacter</h3>
      <p>Pour toute question ou proposition, utilise le formulaire
      de contact qui sera relié à une adresse de réception
      lors d'une prochaine étape.</p>
      <label>Nom</label>
      <input placeholder="Ton nom">
      <label>Adresse e-mail</label>
      <input type="email" placeholder="Ton adresse e-mail">
      <label>Message</label>
      <textarea rows="5" placeholder="Écris ton message"></textarea>
      <p class="small">L'envoi du formulaire n'est pas encore activé.</p>
    </div>
  `);
}

function coming(value) {
  show("Bientôt disponible",`
    <div class="panel">
      <p>La section ${escapeHTML(value)} sera développée
      progressivement sur WiderWay.</p>
    </div>
  `);
}

/* =====================================
   12. NAVIGATION GÉNÉRALE
===================================== */

const actions = {
  home,
  formations,
  library,
  research,
  about,
  contact,
  community,
  country,
  university,
  field,
  level,
  path,
  semester,
  subject,
  resource,
  coming,
  search
};

document.addEventListener("click", function(event) {
  const element = event.target.closest("[data-action]");
  if (!element) return;

  const action = element.dataset.action;
  const value = element.dataset.value || "";

  if (actions[action]) {
    actions[action](value);
  }
});

home();

</script>
</body>
</html>
